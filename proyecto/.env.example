DB_PASSWORD=cambia_esto
MSSQL_SA_PASSWORD=Cambia_esto_123

# --- n8n (parte 7) ---
# Cifra las credenciales de n8n (usa un valor largo y aleatorio)
N8N_ENCRYPTION_KEY=cambia_esto_por_un_valor_largo_y_aleatorio
# Secreto compartido: la API lo manda en la cabecera X-Webhook-Secret y n8n lo comprueba
PEDIDOS_WEBHOOK_SECRET=cambia_esto_por_otro_valor_aleatorio
# Zoho: credenciales de un Self Client NUEVO (nunca las subas al repositorio)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Opcionales (valores por defecto: centro de datos .com y API v8)
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_API_VERSION=v8
# NOTIFICACION_CORREO_DESTINO=equipo@tienda.local
