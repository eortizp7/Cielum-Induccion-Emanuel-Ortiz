      "parameters": {
        "fromEmail": "n8n@tienda.local",
        "toEmail": "={{ $env.NOTIFICACION_CORREO_DESTINO }}",
        "subject": "={{ '[' + $json.estado.toUpperCase() + '] Pedido #' + $json.pedido_id + ' -> Zoho: ' + $json.accion }}",
        "emailFormat": "text",
        "text": "={{ 'Pedido: #' + $json.pedido_id + '\\nSistema: ' + $json.sistema + '\\nAcción: ' + $json.accion + '\\nEstado: ' + $json.estado + '\\nDetalle: ' + $json.detalle }}",
        "options": {}
      },
      "id": "14e06f91-991b-5d54-9f33-ac8e106b2041",
      "name": "Enviar correo",
